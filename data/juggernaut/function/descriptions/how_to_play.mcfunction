give @s written_book[written_book_content={title:"Juggernaut Instructions",author:"BubkisLord",generation:1,pages:[{"text":"","extra":[{"text":"Juggernaut","color":"#FF5555","underlined":true},{"text":"\n\nOne or more "},{"text":"Juggernauts","color":"#FF5555"},{"text":" hunt a team of "},{"text":"Runners","color":"#00AAAA"},{"text":". "},{"text":"Runners","color":"#00AAAA"},{"text":" must "},{"text":"replenish","color":"#00CC00"},{"text":" "},{"text":"stations","color":"#00CC00"},{"text":" before the "},{"text":"Juggernaut(s)","color":"#FF5555"},{"text":" kill them all. The "},{"text":"Juggernaut(s)","color":"#FF5555"},{"text":" win by eliminating all "},{"text":"Runners","color":"#00AAAA"},{"text":". The "},{"text":"Runners","color":"#00AAAA"},{"text":" win by fully "},{"text":"replenishing","color":"#00CC00"},{"text":" enough "},{"text":"stations","color":"#00CC00"}]},{"text":"","extra":[{"text":"Setup","underlined":true},{"text":"\n\nPlayers are picked as "},{"text":"Juggernaut(s)","color":"#FF5555"},{"text":" randomly (Number of "},{"text":"Juggernauts","color":"#FF5555"},{"text":" customisable), and all other players are "},{"text":"Runners","color":"#00AAAA"},{"text":". "},{"text":"Runners","color":"#00AAAA"},{"text":" spawn into the map once every player has picked a kit, and have 25s to prepare,"}]},{"text":"","extra":[{"text":"Setup cont'd","underlined":true},{"text":"\n\nincluding finding a "},{"text":"station","color":"#00CC00"},{"text":" before the "},{"text":"Juggernaut(s)","color":"#FF5555"},{"text":" spawn. "},{"text":"Stations","color":"#00CC00"},{"text":" are blocked from "},{"text":"replenishment","color":"#00CC00"},{"text":" during this time. "},{"text":"Juggernauts","color":"#FF5555"},{"text":" spawn at one of the farthest spawn locations from the "},{"text":"Runners","color":"#00AAAA"},{"text":"."}]},{"text":"","extra":[{"text":"Lives","underlined":true},{"text":"\n\n"},{"text":"Runners","color":"#00AAAA"},{"text":" start with ("},{"text":"Juggernaut","color":"#FF5555"},{"text":" count + 1) lives. When all a "},{"text":"Runner's","color":"#00AAAA"},{"text":" lives are lost, they may spectate the game (by clicking the signs in the lobby). "},{"text":"Juggernauts","color":"#FF5555"},{"text":" have 1 life, their deaths grant "},{"text":"Runners","color":"#00AAAA"},{"text":" an instant win."}]},{"text":"","extra":[{"text":"Replenishment Stations","color":"#00CC00","underlined":true},{"text":"\n\nThese are found around the map, but not necessarily in the same place each game, and may be on multiple/different floors of a building. "},{"text":"Stations","color":"#00CC00"},{"text":" available to be "},{"text":"replenished","color":"#00CC00"},{"text":" are labelled. Be within 3 blocks of a "},{"text":"station","color":"#00CC00"},{"text":" to "},{"text":"replenish","color":"#00CC00"},{"text":". Once a"}]},{"text":"","extra":[{"text":"Replenishment Stations cont'd","color":"#00CC00","underlined":true},{"text":"\n\n"},{"text":"station","color":"#00CC00"},{"text":" reaches 100% "},{"text":"replenishment","color":"#00CC00"},{"text":", it is completed and disappears. If a "},{"text":"Juggernaut","color":"#FF5555"},{"text":" is within 12 blocks of a "},{"text":"station","color":"#00CC00"},{"text":", it cannot be "},{"text":"replenished","color":"#00CC00"},{"text":"."}]},{"text":"","extra":[{"text":"Station","color":"#00CC00","underlined":true},{"text":" Particles","underlined":true},{"text":"\n\nParticles emitted by "},{"text":"stations","color":"#00CC00"},{"text":" indicate information about them.\n\n"},{"text":"Totem","color":"#00FF00"},{"text":": "},{"text":"Station","color":"#00CC00"},{"text":" present\n"},{"text":"Purple","color":"#AA00AA"},{"text":": Warning! "},{"text":"Juggernaut","color":"#FF5555"},{"text":" nearby\n"},{"text":"End Rod","color":"#FF55FF"},{"text":": being "},{"text":"replenished","color":"#00CC00"},{"text":"\n"},{"text":"White Smoke","color":"#AAAAAA"},{"text":": blocked from "},{"text":"replenishment","color":"#00CC00"}]},{"text":"","extra":[{"text":"Station","color":"#00CC00","underlined":true},{"text":" Particles cont'd","underlined":true},{"text":"\n\nSome particles appear only with certain kits present in the game.\n\n"},{"text":"Flame","color":"#FFA500"},{"text":": blocked from "},{"text":"replenishment","color":"#00CC00"},{"text":"\n"},{"text":"Smoke","color":"#555555"},{"text":": "},{"text":"Station","color":"#00CC00"},{"text":" is haunted"}]},{"text":"","extra":[{"text":"The Chase","underlined":true},{"text":"\n\n"},{"text":"Runners","color":"#00AAAA"},{"text":" near a "},{"text":"Juggernaut","color":"#FF5555"},{"text":" can (and usually do) enter chase. While being chased the most "},{"text":"replenished","color":"#00CC00"},{"text":" "},{"text":"station","color":"#00CC00"},{"text":" is "},{"text":"replenished","color":"#00CC00"},{"text":" as if the "},{"text":"Runner","color":"#00AAAA"},{"text":" was on the "},{"text":"station","color":"#00CC00"},{"text":" itself. Chase cannot be entered if the concerned players are shifting."}]},{"text":"","extra":[{"text":"The Chase cont'd","underlined":true},{"text":"\n\nIf a player in chase shifts for sufficiently long, the chase ends."}]},{"text":"","extra":[{"text":"Healing","underlined":true},{"text":"\n\n"},{"text":"Runners","color":"#00AAAA"},{"text":" can still without sneaking while a hurt ally crouches nearby to heal them. Sneaking alone to slowly self-heals. The more health lost, the longer it takes to heal."}]},{"text":"","extra":[{"text":"Perks","underlined":true},{"text":"\n\nPerks are available in ender chests for all players (Number of Perks customisable). Perks can provide buffs to a variety of aspects of the game."}]},{"text":"","extra":[{"text":"Customisation","underlined":true},{"text":"\n\nCustomise signs in the lobby lead to a settings room. Besides aforementioned customisables, Perks (And kits) can be enforced to be randomised for all players, and the "},{"text":"Juggernaut","color":"#FF5555"},{"text":" player can be selected via a Round Robin system."}]},{"text":"","extra":[{"text":"Reset","underlined":true},{"text":"\n\nIf anything breaks, run /function minecraft:reset to fix the game state by resetting the game."}]}]}]

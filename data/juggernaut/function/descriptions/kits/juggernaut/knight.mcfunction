item replace entity @s hotbar.8 with written_book[written_book_content={title:"Knight",author:"§9Server",pages:[\
[{"text": "Knight\n\n","bold": true,"color": "#C8B400"},\
 {"text": "A heavily armoured warrior who charges down foes with a powerful lance.","bold": false,"color": "black"}],\
\
[{"text": "Knight's Lance\n","bold": true,"color": "#C8B400"},{"text": "Active Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Your lance charges over a number of seconds, gaining lunge distance with each stage. At full charge it deals maximum lunge distance. Does not charge on horseback.","bold": false,"color": "black"}],\
\
[{"text": "Summon Steed\n","bold": true,"color": "#C8B400"},{"text": "Active Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Summon a skeleton horse to ride at greater speeds and lance your opponents. The Dismiss Steed ability sends it away.","bold": false,"color": "black"}],\
\
[{"text": "Counterplay\n","bold": true,"color": "#C8B400"},{"text": "When the knight is on his horse running into him and staying inside the horse means he cannot lance you. The Knight will also often overshoot the lance lunge, landing ahead of your position. Turning around quickly and running the other way is excellent in maintaining or even gaining distance.","bold": false,"color": "black"}]]\
}]
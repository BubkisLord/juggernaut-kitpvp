item replace entity @s hotbar.8 with written_book[written_book_content={title:"Phantom",author:"§9Server",pages:[\
[{"text": "Phantom\n\n","bold": true,"color": "#4f298f","underlined": false},\
 {"text": "This kit utilises a ranged attack that works through walls, and an ability to apparate at distant replenishment stations.","bold": false,"color": "black"}],\
 \
[{"text": "Spectral Drift\n","bold": true,"color": "#4f298f"},{"text": "Passive Effect\n\n","bold": true,"color": "gray","italic": true},{"text":"You move at 88% speed (a 12% reduction). You also take reduced fall damage.","bold": false,"color": "black"}],\
\
[{"text": "Reap\n","bold": true,"color": "#4f298f"},{"text": "Activated Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Deal damage to a runner you are looking at, works through blocks up to 48 blocks away. Inflicts Glowing for 7 seconds.\n","color": "black"},{"text": "Cooldown: 12s","color": "dark_gray"}],\
\
[{"text": "Haunt Station\n","bold": true,"color": "#4f298f"},{"text": "Activated Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Apparate at a replenishment station that you are looking at. Hold out the item and look at a station - detection range is up to 250 blocks. When it is a valid teleport it will change color.","bold": false,"color": "black"},{"text": "Cooldown: 40s","color": "dark_gray"}],\
\
[{"text": "Quirks & Exceptions\n","bold": true,"color": "#4f298f"},{"text": "\n","color": "black"},{"text": "- Reap's 48 block range only needs a rough lock; its hit tolerance is narrow (1.5 blocks), so leading a moving target matters more than distance.\n","color": "black"},{"text": "- Reap's cooldown is 12s before any cooldown-reduction modifiers apply, which is rather punishing if you miss.\n","color": "black"},{"text": "- Haunt Station's lock will persist even after you look away. (Will be overridden by looking at other stations, however)","color": "black"}],\
\
[{"text": "Advanced Techniques\n","bold": true,"color": "#4f298f"},{"text": "\n","color": "black"},{"text": "- Predict a Reap through walls to force Glowing on runners if they hide behind a wall, denying them stealth even if you can't chase.\n","color": "black"},{"text": "- Because Reap's cooldown is 12s, don't spam it on cooldown - take your time and hit the runner.\n","color": "black"},{"text": "- The 12% speed penalty is non-trivial. Mobility is strongest when using haunt across the entire map.\n","color": "black"},{"text": "- Locking on a station with haunt emits smoke particles for runners. You can fake a teleport by locking on the station but not executing the ability.","color": "black"}],\
\
[{"text": "Counterplay\n","bold": true,"color": "#4f298f"},{"text": "\n","color": "black"},{"text": "Remain unpredictable while blocking line of sight to avoid being Reaped - walls don't stop Reap, but distance and awkward angles reduce how easily Phantom can track you.\n","color": "black"},{"text": "Making distance is very powerful since Phantom lacks short-range mobility. When a station starts smoking, Phantom is about to teleport there - leaving and hiding denies them any pressure from that apparation.\n","color": "black"}]]}\
]

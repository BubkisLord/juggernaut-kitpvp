item replace entity @s hotbar.8 with written_book[written_book_content={title:"Phantom",author:"§9Server",pages:[\
[{"text": "Phantom\n\n","bold": true,"color": "#4f298f","underlined": false},\
 {"text": "This kit utilises a ranged attack that works through walls, and an ability to apparate at distant replenishment stations.","bold": false,"color": "black"}],\
 \
[{"text": "Spectral Drift\n","bold": true,"color": "#4f298f"},{"text": "Passive Effect\n\n","bold": true,"color": "gray","italic": true},{"text":"You move at 85% speed. You also take less damage from falling.","bold": false,"color": "black"}],\
\
[{"text": "Reap\n","bold": true,"color": "#4f298f"},{"text": "Activated Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Deal damage to a runner you are looking at, making them glowing for 12 seconds. Works through walls.\n","color": "black"},{"text": "Cooldown: 7s","color": "dark_gray"}],\
\
[{"text": "Haunt Station\n","bold": true,"color": "#4f298f"},{"text": "Activated Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Apparate at a replenishment station that you are looking at. Hold out the item and look at a replenishment station. When it is a valid teleport it will change color.","bold": false,"color": "black"},{"text": "Cooldown: 40s","color": "dark_gray"}],\
\
[{"text": "Counterplay\n","bold": true,"color": "#4f298f"},{"text": "Counterplay for phantom is to remain unpredictable while blocking line of sight to avoid being reaped. Additionally, making distance against this juggernaut is very powerful as it lacks short-range mobility. When a station smokes, the phantom is teleporting to it - leaving and hiding away will deny the juggernaut of any pressure when this happens.","bold": false,"color": "black"}]]}\
]

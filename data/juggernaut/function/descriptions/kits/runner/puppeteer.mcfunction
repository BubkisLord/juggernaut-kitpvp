item replace entity @s hotbar.8 with written_book[written_book_content={title:"Puppeteer",author:"§9Server",pages:[\
[{"text": "Puppeteer\n\n","bold": true,"color": "#a64dff","underlined": false},\
 {"text": "A runner who fights beside a lifeless double. You replenish at only 60% efficiency, but you are never truly where you appear to be.","bold": false,"color": "black"}],\
\
[{"text": "Bound Soul\n","bold": true,"color": "#a64dff"},{"text": "Passive\n\n","bold": true,"color": "gray","italic": true},{"text": "You replenish stations at 60% efficiency. While a mannequin is summoned it replenishes at 60% efficiency too (boosted by your replenishment perks). But your life is tied to it: if the mannequin dies, you die.","bold": false,"color": "black"}],\
\
[{"text": "Summon / Pickup Mannequin\n","bold": true,"color": "#a64dff"},{"text": "Active Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Summon a mannequin at your location. It cannot move, so it has a lot of health to compensate, and it slowly replenishes the nearest station. If you stand within 3 blocks of it you may pick it back up.","bold": false,"color": "black"},{"text": "\nCooldown: 20s","bold": false,"color": "dark_gray"}],\
\
[{"text": "Swap\n","bold": true,"color": "#a64dff"},{"text": "Active Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Instantly trade places with your mannequin. Only usable while within 10 blocks of it, OR while it has taken any damage (such as being shot).","bold": false,"color": "black"},{"text": "\nCooldown: 15s","bold": false,"color": "dark_gray"}],\
\
[{"text": "Make Puppets\n","bold": true,"color": "#a64dff"},{"text": "Active Ability\n\n","bold": true,"color": "gray","italic": true},{"text": "Conjure a ring of six identical puppets that move exactly as you do. You swap into one of them, so the Juggernaut cannot tell which figure is real. Each puppet dies in a single hit.","bold": false,"color": "black"},{"text": "\nCooldown: 1m 30s","bold": false,"color": "dark_gray"}],\
\
[{"text": "Counterplay\n","bold": true,"color": "#a64dff"},{"text": "The Puppeteer is fragile: destroy the summoned mannequin and the Puppeteer dies with it. Against the puppets, watch for the one that reacts to your swings or hesitates a fraction differently, and remember the puppets fall to a single hit while the real player does not.","bold": false,"color": "black"}]]\
}]
